{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "seicons",
	"compatibility_date": "2026-04-20",
	"main": ".open-next/worker.js",
	// adapter 输出的入口
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "seicons",
			"database_id": "3101a6fb-9fd7-4eb3-8a5e-61d28cd852ed"
		}
	]
}