{
  "name": "seicons",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 7611 --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "adapter": "next build && opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "generate:icons": "node scripts/generate-icons-db.mjs",
    "prebuild": "pnpm run generate:icons",
    "d1:create": "wrangler d1 create seicons",
    "generate:sql": "node scripts/export-d1-sql.mjs",
    "d1:seed": "wrangler d1 execute seicons --remote --file=./src/data/icons.sql",
    "d1:seed:large": "node scripts/seed-d1-large.mjs",
    "d1:seed:all": "pnpm d1:seed && pnpm d1:seed:large",
    "d1:seed:local": "wrangler d1 execute seicons --local --file=./src/data/icons.sql"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@heroicons/react": "^2.2.0",
    "@lineiconshq/free-icons": "^1.0.6",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "@remixicon/react": "^4.9.0",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "lucide-react": "^1.16.0",
    "react-icons": "^5.6.0",
    "svgmoji": "^3.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.81.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "dependencies": {
    "@opennextjs/cloudflare": "^1.18.0",
    "accept-language": "^3.0.20",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sql.js": "^1.14.1"
  }
}
