# .cbmignore
# Only rules that supplement .gitignore (codebase-memory-mcp already reads .gitignore).
# Use leading / to anchor patterns to the repo root for reliability.

# Build outputs (root-level) — anchored
/build/
/target/
/out/
/output/
/dist/

# C++ dependency trees (can be massive even if nested inside /build/)
vcpkg_installed/
vcpkg/installed/

# Nested Gradle/Android build dirs not covered by root-anchored /build/
dawn/app/build/
dawn/app/.gradle/
dawn/.gradle/

# Node / frontend artifacts
node_modules/
.pnpm-store/
justitia/dist/
justitia/.vite/
justitia/.rollup.cache/

# Generated / binary artifacts
*.onnx
*.pt
*.bin
*.pth
*.h5
*.safetensors
*.model
*.parquet
*.arrow
*.pdb

